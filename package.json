{
  "name": "fruitbiz",
  "version": "1.7.37",
  "description": "Local offline business document system",
  "author": {
    "name": "Suphasin",
    "email": "support@localbiz.app"
  },
  "homepage": "https://github.com/suphasin01/fruit",
  "repository": {
    "type": "git",
    "url": "https://github.com/suphasin01/fruit.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc",
    "build:ui": "cd src-ui && npm install && npm run build",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "start": "node dist/api.js",
    "mcp": "node dist/mcp.js",
    "electron": "npm run build:ui && npm run build && electron .",
    "dist": "npm run build:ui && npm run build && electron-builder",
    "dist:win": "npm run build:ui && npm run build && electron-builder --win --publish always",
    "dist:win-portable": "npm run build:ui && npm run build && electron-builder --win portable --publish always",
    "dist:mac": "npm run build:ui && npm run build && electron-builder --mac --publish always",
    "release:win": "npm run build:ui && npm run build && electron-builder --win --publish always",
    "release:mac": "npm run build:ui && npm run build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "electron-log": "^5.1.2",
    "electron-updater": "^6.3.4",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "playwright-core": "^1.60.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.localbiz.app",
    "productName": "FruitBiz",
    "copyright": "Copyright © 2026 FruitBiz",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "web/**/*",
      "build-info.json",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "publish": {
      "provider": "github",
      "owner": "suphasin01",
      "repo": "fruit",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.business",
      "darkModeSupport": true,
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FruitBiz",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "dmg": {
      "title": "FruitBiz",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
